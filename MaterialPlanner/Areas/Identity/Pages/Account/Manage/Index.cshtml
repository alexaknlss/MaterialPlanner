@page
@model MaterialPlanner.Areas.Identity.Pages.Account.Manage.IndexModel
@{
    ViewData["Title"] = "Mi cuenta";
}

<h2>@ViewData["Title"]</h2>

<div>
    <dl class="row">
        <dt class="col-sm-2">Usuario</dt>
        <dd class="col-sm-10">@Model.Username</dd>

        <dt class="col-sm-2">Correo electrónico</dt>
        <dd class="col-sm-10">@Model.Email</dd>
    </dl>
</div>
