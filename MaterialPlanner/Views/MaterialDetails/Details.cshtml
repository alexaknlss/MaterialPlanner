@model MaterialPlanner.Models.MaterialDetails

@{
    ViewData["Title"] = "Details";
}

<h1>Material Details</h1>

<hr />

<div class="row">

    <!-- ===================== -->
    <!-- COLUMNA IZQUIERDA -->
    <!-- ===================== -->
    <div class="col-md-4">

        <div class="card shadow-sm mb-3">
            <div class="card-header bg-dark text-white">
                Material Info
            </div>

            <div class="card-body">

                <p><strong>Material:</strong> @Model.Material?.Description </p>
                <p><strong class="badge bg-info text-dark">Item Material:</strong> @Model.Material?.ItemMaterial </p>

                <p><strong>Brand:</strong> @Model.Brand?.Name </p>

                <p><strong>Product:</strong> @Model.Product?.Description </p>
                <p><strong class="badge bg-info text-dark">SKU:</strong> @Model.Product?.SKU </p>

                <p><strong>Presentation:</strong> @Model.Presentation?.Name </p>

                <p>
                    <strong>Status:</strong>
                    @(Model.Status ? "Active" : "Inactive")
                </p>

                <p>
                    <strong>Consumption:</strong>
                    @Model.Consumption @Model.Unit?.Name
                </p>

            </div>
        </div>

        <!-- FORMULARIO IMAGEN -->
        <div class="card shadow-sm">

            <div class="card-header bg-success text-white">
                Add Image
            </div>

            <div class="card-body">

                <form asp-controller="Images"
                      asp-action="Create"
                      method="post"
                      enctype="multipart/form-data">

                    @Html.AntiForgeryToken()

                    <input type="hidden" name="MaterialDetailsId" value="@Model.Id" />

                    <div class="mb-3">
                        <input type="file" name="file" class="form-control" required />
                    </div>

                    <div class="mb-3">
                        <input type="text"
                               name="Description"
                               class="form-control"
                               placeholder="Description (optional)" />
                    </div>

                    <button type="submit" class="btn btn-success w-100">
                        Upload Image
                    </button>

                </form>

            </div>
        </div>

    </div>

    <!-- ===================== -->
    <!-- COLUMNA DERECHA -->
    <!-- ===================== -->
    <div class="col-md-8">

        <div class="card shadow-sm">

            <div class="card-header bg-primary text-white">
                Image Gallery
            </div>

            <div class="card-body" style="max-height: 750px; overflow-y:auto;">

                @if (Model.Images != null && Model.Images.Any())
                {
                    <div class="row">

                        @foreach (var img in Model.Images)
                        {
                            <div class="col-md-6 mb-3">

                                <div class="card position-relative shadow-sm">

                                    <!-- DELETE -->
                                    <form asp-controller="Images"
                                          asp-action="Delete"
                                          asp-route-id="@img.Id"
                                          method="post"
                                          class="position-absolute"
                                          style="top:10px; right:10px; z-index:10;">

                                        @Html.AntiForgeryToken()

                                        <button type="submit"
                                                class="btn btn-sm btn-danger rounded-circle btn-delete">
                                            🗑
                                        </button>

                                    </form>

                                    <!-- CLICKABLE IMAGE -->
                                    <a asp-controller="Images"
                                       asp-action="Details"
                                       asp-route-id="@img.Id"
                                       class="d-block">

                                        <img src="@Url.Content(img.Path)"
                                             class="card-img-top"
                                             style="height:200px; object-fit:cover; cursor:pointer;" />

                                    </a>

                                    <div class="card-body p-2 text-center">
                                        <small class="text-muted">
                                            @img.Description
                                        </small>
                                    </div>

                                </div>

                            </div>
                        }

                    </div>
                }
                else
                {
                    <p class="text-muted">No images available.</p>
                }

            </div>
        </div>

    </div>

</div>

<!-- BOTONES -->
<div class="mt-3">

    <a asp-action="Edit"
       asp-route-id="@Model.Id"
       class="btn btn-primary">
        Edit
    </a>

    <a asp-action="Index"
       class="btn btn-secondary">
        Back to List
    </a>

    <a asp-action="ReportePDF"
       asp-route-id="@Model.Id"
       class="btn btn-danger">
        Generar PDF
    </a>

</div>

<!-- SWEETALERT -->
<script>
    document.addEventListener("DOMContentLoaded", function () {

        document.querySelectorAll('.btn-delete').forEach(button => {

            button.addEventListener('click', function (e) {
                e.preventDefault();

                let form = this.closest('form');

                Swal.fire({
                    title: "Are you sure?",
                    text: "This image will be permanently deleted!",
                    icon: "warning",
                    showCancelButton: true,
                    confirmButtonColor: "#d33",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Yes, delete it!"
                }).then((result) => {
                    if (result.isConfirmed) {
                        form.submit();
                    }
                });

            });

        });

    });
</script>