@using X.PagedList.Mvc.Core
@using X.PagedList

@model IPagedList<MaterialPlanner.Models.MaterialDetails>

@{
    ViewData["Title"] = "Material Details";
}

<div class="container-fluid mt-6">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Material Details</h2>

        
        <form id="filterForm" asp-action="Index" method="get" class="d-flex align-items-end gap-2">

            <div>
                <label class="form-label small mb-1">From</label>
                <input type="date"
                       name="startDate"
                       value="@ViewBag.StartDate"
                       class="form-control form-control-sm" />
            </div>

            <div>
                <label class="form-label small mb-1">To</label>
                <input type="date"
                       name="endDate"
                       value="@ViewBag.EndDate"
                       class="form-control form-control-sm" />
            </div>

            <button type="submit" class="btn btn-primary btn-sm">
                Filter
            </button>

            <a asp-action="Index" class="btn btn-secondary btn-sm">
                Clear
            </a>

            <a asp-action="ExportToExcel"
               asp-route-startDate="@ViewBag.StartDate"
               asp-route-endDate="@ViewBag.EndDate"
               class="btn btn-success btn-sm">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </a>

            <a asp-action="Create" class="btn btn-primary btn-sm">
                + Create New
            </a>

        </form>

    </div>
   


    <div class="card shadow-sm border-0">
        <div class="card-body ">

            <div class="table-responsive">
                <table class="table table-hover align-middle w-100">

                    <thead class="table-dark">
                        <tr>
                            <th style="width: 20%;">Material</th>
                            <th>Brand</th>
                            <th style="width: 20%;">Product</th>
                            <th>Presentation</th>
                            <th>Status</th>
                            <th class="text-center">Consumption</th>
                            <th class="text-center">Fecha de creación</th>


                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr onclick="window.location='@Url.Action("Details", new { id = item.Id })'"
                                style="cursor:pointer;">
                                <td style="width: 20%;">
                                    <strong>@item.Material?.Description</strong>
                                    <br />
                                    <span class="badge bg-info text-dark">
                                        ITEM: @item.Material?.ItemMaterial
                                    </span>
                                </td>
                               
                                <td style="width: 20%;">
                                    <strong>@item.Brand?.Name </strong>  
                                </td>


                                <td style="width: 20%;">
                                    <strong>@item.Product?.Description</strong>
                                    <span class="badge bg-info text-dark">
                                        SKU: @item.Product?.SKU
                                    </span>
                                    <br />
                                    
                                </td>
                                



                                <td style="width: 20%;">
                                    <strong>@item.Presentation?.Name</strong>
                                    
                                    
                                </td>
                                   

                                <td>
                                    <span class="badge @(item.Status ? "bg-success" : "bg-secondary")">
                                        @(item.Status ? "Active" : "Inactive")
                                    </span>
                                </td>



                                <td class="text-center">@item.Consumption @item.Unit?.Name</td>

                               <!-- nuevalinea-->
                                <td style="width: 20%;">
                                    <strong>@item.CreatedAt.ToString("dd/MM/yyyy hh:mm tt")</strong>
                                </td>

                                <td class="text-center">
                                    <div class="d-flex justify-content-center align-items-center gap-2">

                                        <a asp-action="Edit"
                                           asp-route-id="@item.Id"
                                           class="btn btn-sm btn-warning d-flex align-items-center justify-content-center"
                                           title="Edit">
                                            <i class="bi bi-pencil-fill"></i>
                                        </a>

                                        

                                        <form asp-action="Delete"
                                              asp-route-id="@item.Id"
                                              method="post"
                                              class="d-inline delete-form m-0">

                                            <button type="button"
                                                    onclick="event.stopPropagation();"
                                                    class="btn btn-sm btn-danger d-flex align-items-center justify-content-center btn-delete"
                                                    title="Delete">
                                                <i class="bi bi-trash-fill"></i>
                                            </button>

                                        </form>

                                    </div>
                                </td>

                            </tr>

                        }
                    </tbody>

                </table>
                       <!--paguination-->

                <nav aria-label="Page navigation">
                    <ul class="pagination justify-content-center">

                        <!--Anterior -->
                        <li class="page-item @(Model.HasPreviousPage ? "" : "disabled")">
                            <a class="page-link"
                               href="@Url.Action("Index", new
                               {
                                   page = Model.PageNumber - 1,
                                   startDate = ViewBag.StartDate,
                                   endDate = ViewBag.EndDate
                               })"
                               aria-label="Previous">
                                <span aria-hidden="true">&laquo;</span>
                            </a>
                        </li>

                        <!--paguinas numeradas-->
                        @for (int i = 1; i <= Model.PageCount; i++)
                        {
                            <li class="page-item @(i == Model.PageNumber ? "active" : "")">
                                <a class="page-link"
                                   href="@Url.Action("Index", new
                                   {
                                       page = i,
                                       startDate = ViewBag.StartDate,
                                       endDate = ViewBag.EndDate
                                   })">
                                    @i
                                </a>
                            </li>
                        }

                        <!--btn siguiente-->
                        <li class="page-item @(Model.HasNextPage ? "" : "disabled")">
                            <a class="page-link"
                               href="@Url.Action("Index", new
                               {
                                   page = Model.PageNumber + 1,
                                   startDate = ViewBag.StartDate,
                                   endDate = ViewBag.EndDate
                               })"
                               aria-label="Next">
                                <span aria-hidden="true">&raquo;</span>
                            </a>
                        </li>

                    </ul>
                </nav>
            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll('.btn-delete').forEach(button => {

                button.addEventListener('click', function () {

                    let form = this.closest('form');

                    Swal.fire({
                        title: "Are you sure?",
                        text: "This record will be permanently deleted!",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#d33",
                        cancelButtonColor: "#6c757d",
                        confirmButtonText: "Yes, delete it!"
                    }).then((result) => {

                        if (result.isConfirmed) {
                            form.submit();
                        } 

                    });

                });

            });

        });
    </script>

}