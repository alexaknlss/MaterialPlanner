@model IEnumerable<MaterialPlanner.Models.MaterialDetails>

@{
    ViewData["Title"] = "Material Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Material Details</h2>

        <a asp-action="Create" class="btn btn-primary">
            + Create New
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th style="width: 20%;">Material</th>
                            <th>Brand</th>
                            <th style="width: 20%;">Product</th>
                            <th>Presentation</th>
                            <th>Status</th>
                            <th class="text-center">Consumption</th>
                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="width: 20%;">
                                    <strong>@item.Material?.Description</strong>
                                    <br />
                                    <span class="badge bg-info text-dark">
                                        ITEM: @item.Material?.ItemMaterial
                                    </span>
                                </td>
                                <td style="width: 20%;">
                                    <strong>@item.Product?.Description</strong>
                                    <br />
                                    <span class="badge bg-info text-dark">
                                        SKU: @item.Product?.SKU
                                    </span>
                                </td>
                                <td>@item.Presentation?.Name</td>

                                <td>
                                    <span class="badge @(item.Status ? "bg-success" : "bg-secondary")">
                                        @(item.Status ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <td class="text-center">@item.Construction</td>

                                <td class="text-center">

                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning">
                                        Edit
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info">
                                        Details
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-danger">
                                        Delete
                                    </a>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

</div>