@model IEnumerable<MaterialPlanner.Models.MaterialDetails>

@{
    ViewData["Title"] = "Material Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="mb-0">Material Details</h2>

        <div>
            <a asp-action="ExportToExcel" class="btn btn-success me-2">
                <i class="bi bi-file-earmark-excel"></i> Export Excel
            </a>

            <a asp-action="Create" class="btn btn-primary">
                + Create New
            </a>
        </div>
    </div>
   

    <div class="card shadow-sm border-0">
        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-hover align-middle">

                    <thead class="table-dark">
                        <tr>
                            <th style="width: 20%;">Material</th>
                            <th>Brand</th>
                            <th style="width: 20%;">Product</th>
                            <th>Presentation</th>
                            <th>Status</th>
                            <th class="text-center">Consumption</th>
                            


                            <th class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td style="width: 20%;">
                                    <strong>@item.Material?.Description</strong>
                                    <br />
                                    <span class="badge bg-info text-dark">
                                        ITEM: @item.Material?.ItemMaterial
                                    </span>
                                </td>
                               
                                <td style="width: 20%;">
                                    <strong>@item.Brand?.Name</strong>  
                                </td>


                                <td style="width: 20%;">
                                    <strong>@item.Product?.Description</strong>
                                    <span class="badge bg-info text-dark">
                                        SKU: @item.Product?.SKU
                                    </span>
                                    <br />
                                    
                                </td>
                                <td>@item.Presentation?.Name</td>



                                <td style="width: 20%;">
                                    <strong>@item.Presentation?.Name</strong>
                                    <br />
                                    
                                </td>
                                   

                                <td>
                                    <span class="badge @(item.Status ? "bg-success" : "bg-secondary")">
                                        @(item.Status ? "Active" : "Inactive")
                                    </span>
                                </td>

                                <td class="text-center">@item.Construction</td>
                              

                                <td class="text-center">
                                    <a asp-action="Edit"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-warning"
                                       title="Edit">
                                        <i class="bi bi-pencil-fill"></i>
                                    </a>

                                    <a asp-action="Details"
                                       asp-route-id="@item.Id"
                                       class="btn btn-sm btn-info"
                                       title="Details">
                                        <i class="bi bi-eye"></i>
                                    </a>

                                    <form asp-action="Delete"
                                          asp-route-id="@item.Id"
                                          method="post"
                                          class="d-inline delete-form">

                                        <button type="button"
                                                class="btn btn-sm btn-danger btn-delete">
                                            <i class="bi bi-trash-fill"></i>
                                        </button>

                                    </form>

                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            document.querySelectorAll('.btn-delete').forEach(button => {

                button.addEventListener('click', function () {

                    let form = this.closest('form');

                    Swal.fire({
                        title: "Are you sure?",
                        text: "This record will be permanently deleted!",
                        icon: "warning",
                        showCancelButton: true,
                        confirmButtonColor: "#d33",
                        cancelButtonColor: "#6c757d",
                        confirmButtonText: "Yes, delete it!"
                    }).then((result) => {

                        if (result.isConfirmed) {
                            form.submit();
                        } 

                    });

                });

            });

        });
    </script>

}