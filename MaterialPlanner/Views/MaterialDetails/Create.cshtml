@model MaterialPlanner.Models.MaterialDetails

@{
    ViewData["Title"] = "Create";
}

<h1>Create Material Detail</h1>

<hr />

<div class="row">
    <div class="col-md-6">

        <form asp-action="Create" method="post">
            @Html.AntiForgeryToken()

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- MATERIAL -->
            <div class="mb-3">
                <label asp-for="MaterialId" class="form-label"></label>
                <select asp-for="MaterialId"
                        asp-items="ViewBag.MaterialId"
                        class="form-select">
                    <option value="">-- Select Material --</option>
                </select>
                <span asp-validation-for="MaterialId" class="text-danger"></span>
            </div>

            <!-- BRAND -->
            <div class="mb-3">
                <label asp-for="BrandId" class="form-label"></label>
                <select asp-for="BrandId"
                        asp-items="ViewBag.BrandId"
                        class="form-select">
                    <option value="">-- Select Brand --</option>
                </select>
                <span asp-validation-for="BrandId" class="text-danger"></span>
            </div>

            <!-- PRODUCT -->
            <div class="mb-3">
                <label asp-for="ProductId" class="form-label"></label>
                <select asp-for="ProductId"
                        asp-items="ViewBag.ProductId"
                        class="form-select">
                    <option value="">-- Select Product --</option>
                </select>
                <span asp-validation-for="ProductId" class="text-danger"></span>
            </div>

            <!-- PRESENTATION -->
            <div class="mb-3">
                <label asp-for="PresentationId" class="form-label"></label>
                <select asp-for="PresentationId"
                        asp-items="ViewBag.PresentationId"
                        class="form-select">
                    <option value="">-- Select Presentation --</option>
                </select>
                <span asp-validation-for="PresentationId" class="text-danger"></span>
            </div>

            <!-- STATUS -->
            <div class="form-check mb-3">
                <input asp-for="Status" class="form-check-input" />
                <label asp-for="Status" class="form-check-label"></label>
            </div>

            <!-- CONSUMPTION -->
            <div class="mb-3">
                <label asp-for="Consumption" class="form-label"></label>
                <input asp-for="Consumption"
                       class="form-control"
                       placeholder="Enter quantity (e.g. 10)" />
                <span asp-validation-for="Consumption" class="text-danger"></span>
            </div>

            <!-- UNIT -->
            <div class="mb-3">
                <label asp-for="UnitId" class="form-label"></label>

                <div class="input-group">

                    <select asp-for="UnitId"
                            id="unitSelect"
                            class="form-select">

                        <option value="">-- Select Unit --</option>

                        @foreach (var item in ViewBag.Units)
                        {
                            <option value="@item.Id">
                                @item.Name
                            </option>
                        }

                    </select>

                    <!-- BOTÓN AGREGAR UNIT -->
                    <button type="button"
                            class="btn btn-outline-primary"
                            id="btnAddUnit"
                            title="Add Unit">
                        <i class="bi bi-plus-lg"></i>
                    </button>

                    <!-- BOTÓN GESTIONAR UNITS -->
                    <a asp-controller="Units"
                       asp-action="Index"
                       asp-route-returnUrl="@Url.Action("Create", "MaterialDetails")"
                       class="btn btn-outline-secondary"
                       title="Manage Units">
                        <i class="bi bi-card-list"></i>
                    </a>

                </div>

                <span asp-validation-for="UnitId" class="text-danger"></span>
            </div>

            <!-- HELP -->
            <div class="alert alert-info p-2">
                <small>
                    Example: 10 kg, 5 m, 20 pcs
                </small>
            </div>

            <!-- BUTTONS -->
            <button type="submit" class="btn btn-primary">
                Save
            </button>

            <a asp-action="Index" class="btn btn-secondary">
                Cancel
            </a>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        $(document).ready(function () {

            // AGREGAR UNIT DESDE BOTÓN +
            $("#btnAddUnit").click(async function () {

                const result = await Swal.fire({
                    title: 'Add new unit',
                    input: 'text',
                    inputLabel: 'Unit name',
                    inputPlaceholder: 'e.g. Box',
                    showCancelButton: true,
                    confirmButtonText: 'Save'
                });

                if (!result.isConfirmed || !result.value) return;

                let name = result.value.trim();
                if (name === "") return;

                try {
                    const response = await $.ajax({
                        url: '/Units/CreateAjax',
                        type: 'POST',
                        data: { name: name }
                    });

                    $("<option>")
                        .val(response.id)
                        .text(response.name)
                        .appendTo("#unitSelect");

                    $("#unitSelect").val(response.id);

                    Swal.fire("Success", "Unit added", "success");

                } catch (err) {
                    Swal.fire("Error", "Could not add unit", "error");
                }
            });

        });
    </script>
}