@model MaterialPlanner.Models.MaterialDetails

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte de Material</title>

    <style>
            .imagenes {
                width: 100%;
                margin-top: 20px;
            }

            .tabla-imagenes {
                width: 100%;
                border-collapse: collapse;
            }

            .img-cell {
                width: 50%;
                padding: 10px;
                text-align: center;
            }

                .img-cell img {
                    width: 100%;
                    height: 250px;
                    object-fit: cover;
                    border-radius: 8px;
                    border: 1px solid #ccc;
                }






    </style>

</head>

<body>

    <div class="reporte">

        <h2>REPORTE DE MATERIAL</h2>

        <!-- ================= INFO ================= -->
        <div class="info-card">

            <div class="info-header">
                INFORMACIÓN DEL MATERIAL
            </div>

            <div class="info-body">
                <div class="info-grid">
                    <div class="info-item">
                        <span class="label">Material</span>
                        <span class="value">@Model.Material?.Description</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Marca</span>
                        <span class="value">@Model.Brand?.Name</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Producto</span>
                        <span class="value">@Model.Product?.Description</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Presentación</span>
                        <span class="value">@Model.Presentation?.Name</span>
                    </div>
                    <div class="info-item">
                        <span class="label">Unidad</span>
                        <span class="value">@Model.Unit?.Name</span>
                    </div>
                    <div class="info-item highlight">
                        <span class="label">Consumo</span>
                        <span class="value">@Model.Consumption</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- IMAGENES  -->
        <div class="imagenes">

    <h3>IMÁGENES</h3>

    @if (Model.Images != null && Model.Images.Any())
    {
        <table class="tabla-imagenes">

            <tr>
                @{
                    int count = 0;
                }

                @foreach (var img in Model.Images)
                {
                    if (count % 2 == 0 && count != 0)
                    {
                        @:</tr><tr>
                    }

                    <td class="img-cell">
                        <img src="@img.Path" />
                    </td>

                    count++;
                }
            </tr>

        </table>
    }
    else
    {
        <div class="no-image">
            No hay imágenes disponibles
        </div>
    }

</div>

    </div>

</body>
</html>