@model MaterialPlanner.Models.MaterialDetails

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Reporte de Material</title>

    <style>
            * {
                box-sizing: border-box;
            }

            body {
                margin: 20px;
                font-family: Arial, Helvetica, sans-serif;
                font-size: 14px;
                color: #000;
            }

            /* CONTENEDOR PRINCIPAL */
            .reporte {
                border: 3px solid #000;
                padding: 25px;
                min-height: 95vh;
            }

            h2 {
                text-align: center;
                margin-bottom: 25px;
            }

            /* ===================== */
            /* INFO BOX (ARRIBA) */
            /* ===================== */
            .info {
                border: 2px solid #000;
                border-radius: 20px;
                overflow: hidden;
                margin-bottom: 25px;
            }

            .info-header {
                text-align: center;
                font-weight: bold;
                padding: 12px;
                border-bottom: 2px solid #000;
                background: #f2f2f2;
            }

            .info-body {
                padding: 15px 20px;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px 20px;
            }

            .info-item {
                display: flex;
                gap: 5px;
            }

            .label {
                font-weight: bold;
            }

            /* ===================== */
            /* IMAGENES (ABAJO) */
            /* ===================== */
            .imagenes {
                border: 2px solid #000;
                border-radius: 20px;
                padding: 15px;
            }

                .imagenes h3 {
                    text-align: center;
                    margin-bottom: 15px;
                }

            .galeria {
                display: grid;
                grid-template-columns: repeat(2, 1fr);
                gap: 15px;
            }

            .img-box {
                border: 2px solid #000;
                height: 220px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: #fafafa;
            }

                .img-box img {
                    max-width: 100%;
                    max-height: 100%;
                    object-fit: contain;
                }

            .no-image {
                font-style: italic;
                color: #777;
            }

    </style>

</head>

<body>

    <div class="reporte">

        <h2>REPORTE DE MATERIAL</h2>

        <!-- ================= INFO ================= -->
        <div class="info">

            <div class="info-header">
                INFORMACIÓN
            </div>

            <div class="info-body">

                <div class="info-item">
                    <span class="label">Material:</span>
                    <span>@Model.Material?.Description</span>
                </div>

                <div class="info-item">
                    <span class="label">Marca:</span>
                    <span>@Model.Brand?.Name</span>
                </div>

                <div class="info-item">
                    <span class="label">Producto:</span>
                    <span>@Model.Product?.Description</span>
                </div>

                <div class="info-item">
                    <span class="label">Presentación:</span>
                    <span>@Model.Presentation?.Name</span>
                </div>

                <div class="info-item">
                    <span class="label">Unidad:</span>
                    <span>@Model.Unit?.Name</span>
                </div>

                <div class="info-item">
                    <span class="label">Consumo:</span>
                    <span>@Model.Consumption</span>
                </div>

            </div>

        </div>

        <!-- IMAGENES  -->
        <div class="imagenes">

            <h3>IMÁGENES</h3>

            @if (Model.Images != null && Model.Images.Any())
            {
                <div class="galeria">

                    @foreach (var img in Model.Images)
                    {
                        <div class="img-box">
                            <img src="@img.Path" />
                        </div>
                    }

                </div>
            }
            else
            {
                <div class="no-image">
                    No hay imágenes disponibles
                </div>
            }

        </div>

    </div>

</body>
</html>