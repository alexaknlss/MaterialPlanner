@model MaterialPlanner.Models.Image

@{
    ViewData["Title"] = "Upload Image";
}

<h2>Upload Image</h2>

<hr />

<div class="row">
    <div class="col-md-5">

        <form asp-action="Create" method="post" enctype="multipart/form-data">

            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <!-- Description -->
            <div class="form-group mb-3">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>

            <!-- File -->
            <div class="form-group mb-3">
                <label>Image File (JPG / PNG)</label>
                <input type="file" name="file" class="form-control" accept=".jpg,.jpeg,.png" />
            </div>

            <!-- MaterialDetails -->
            <div class="form-group mb-3">
                <label asp-for="MaterialDetailsId" class="control-label"></label>
                <select asp-for="MaterialDetailsId"
                        asp-items="ViewBag.MaterialDetailsId"
                        class="form-control">
                    <option value="">-- Select Material Detail --</option>
                </select>
                <span asp-validation-for="MaterialDetailsId" class="text-danger"></span>
            </div>

            <!-- Submit -->
            <div class="form-group">
                <input type="submit" value="Upload" class="btn btn-primary" />
            </div>

        </form>

    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}