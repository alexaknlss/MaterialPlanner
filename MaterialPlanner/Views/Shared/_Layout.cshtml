                    <span>Inicio</span>
                </a>

                <a asp-controller="MaterialDetails" asp-action="Index" class="sidebar-link">
                    <i class="bi bi-layers"></i>
                    <span>Material Details</span>
                </a>

                <div class="sidebar-section">Management</div>

                <a asp-controller="Brands" asp-action="Index" class="sidebar-link">
                    <i class="bi bi-tags"></i>
                    <span>Brands</span>
                </a>

                <a asp-controller="Products" asp-action="Index" class="sidebar-link">
                    <i class="bi bi-bag"></i>
                    <span>Products</span>
                </a>

                <a asp-controller="Materials" asp-action="Index" class="sidebar-link">
