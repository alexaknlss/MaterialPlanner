@{
    ViewData["Title"] = "Home Page";
}

<div class="container mt-4">

    <div class="text-center mb-4">
        <h1 class="display-4">Material Planner</h1>
        <p class="text-muted">Dashboard principal del sistema</p>
    </div>

    <div class="row justify-content-center">

        <!-- BRANDS -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Brands</h5>
                    <p class="card-text text-muted">Manage all brands</p>

                    <a asp-controller="Brands" asp-action="Index"
                       class="btn btn-outline-primary btn-lg w-100">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- PRODUCTS -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Products</h5>
                    <p class="card-text text-muted">Manage products list</p>

                    <a asp-controller="Products" asp-action="Index"
                       class="btn btn-outline-success btn-lg w-100">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- MATERIALS -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Materials</h5>
                    <p class="card-text text-muted">Manage materials</p>

                    <a asp-controller="Materials" asp-action="Index"
                       class="btn btn-outline-warning btn-lg w-100">
                        Open
                    </a>
                </div>
            </div>
        </div>

        <!-- PRESENTATIONS -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Presentations</h5>
                    <p class="card-text text-muted">Manage presentations</p>

                    <a asp-controller="Presentations" asp-action="Index"
                       class="btn btn-outline-dark btn-lg w-100">
                        Open
                    </a>
                </div>
            </div>
        </div>
        <!-- MaterialDetails  aun falta agregar la dependencia de vistas y tambien de controlador-->
        <!-- MaterialDetails -->
        <div class="col-md-3 mb-3">
            <div class="card shadow-sm border-0">
                <div class="card-body text-center">
                    <h5 class="card-title">Material Details</h5>
                    <p class="card-text text-muted">
                        Manage material relationships
                    </p>

                    <a asp-controller="MaterialDetails"
                       asp-action="Index"
                       class="btn btn-outline-dark btn-lg w-100">
                        Open
                    </a>
                </div>
            </div>
        </div>

    </div>

</div>